---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/navigation/Navigation.astro";
import Hero from "../components/home/Hero.astro";
import Statement from "../components/home/Statement.astro";
import ProjectsGrid from "../components/home/ProjectsGrid.astro";
import SkillsSection from "../components/home/SkillsSection.astro";
import StatsSection from "../components/home/StatsSection.astro";
import CTASection from "../components/home/CTASection.astro";

const title = "Dityath - Portofolio";
const description =
  "Ditya Athallah's portfolio of a fullstack developer specializing in React, TypeScript, Golang, and Rust. Building things that don't break.";
---

<BaseLayout title={title} description={description}>
  <Navigation />
  <main>
    <Hero />
    <Statement />
    <ProjectsGrid />
    <SkillsSection />
    <StatsSection />
    <CTASection />
  </main>
</BaseLayout>
