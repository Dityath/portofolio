---
import type { SocialLink } from "../../types";

const socialLinks: SocialLink[] = [
  { name: "GitHub", url: "https://github.com/yourusername" },
  { name: "LinkedIn", url: "https://linkedin.com/in/yourusername" },
  { name: "Medium", url: "https://medium.com/@yourusername" },
  { name: "Twitter", url: "https://twitter.com/yourusername" },
];

const email = "your.email@example.com";
---

<section class="cta section-brutal" id="contact">
  <div class="container-brutal">
    <h2 class="cta-title">LET'S WORK →</h2>

    <div class="cta-content">
      <p class="cta-text">
        Available for freelance projects, full-time opportunities, and
        collaborations.
      </p>

      <a href={`mailto:${email}`} class="cta-email">
        {email}
      </a>

      <div class="social-links">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              class="social-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.name} →
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container-brutal">
    <p class="footer-text">
      © {new Date().getFullYear()} YOUR NAME. BUILT WITH ASTRO + GSAP + BUN.
    </p>
  </div>
</footer>

<style>
  .cta {
    text-align: center;
  }

  .cta-title {
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
    transition: all 0.3s ease;
  }

  .cta-title:hover {
    color: var(--color-accent);
    transform: scale(1.05);
  }

  .cta-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-text {
    font-family: "IBM Plex Mono", monospace;
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .cta-email {
    display: inline-block;
    font-family: "JetBrains Mono", monospace;
    font-size: 1.5rem;
    font-weight: 700;
    padding: 1.5rem 3rem;
    border: 5px solid var(--color-fg);
    margin-bottom: 3rem;
    transition: all 0.3s ease;
  }

  .cta-email:hover {
    background: var(--color-fg);
    color: var(--color-bg);
    transform: scale(1.1);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .social-link {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 3px solid transparent;
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
  }

  .footer {
    padding: 4rem 0;
    border-top: 2px solid var(--color-fg);
    text-align: center;
  }

  .footer-text {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
    opacity: 0.7;
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .social-links {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { glitchText } from "../../lib/gsap-config";

  document.addEventListener("astro:page-load", () => {
    const ctaTitle = document.querySelector(".cta-title");
    const ctaEmail = document.querySelector(".cta-email");
    const socialLinks = document.querySelectorAll(".social-link");

    if (ctaTitle) {
      // Glitch effect on hover
      ctaTitle.addEventListener("mouseenter", () => {
        if (ctaTitle instanceof HTMLElement) {
          glitchText(ctaTitle);
        }
      });
    }

    if (ctaEmail) {
      // Scale animation on hover
      ctaEmail.addEventListener("mouseenter", () => {
        gsap.to(ctaEmail, {
          scale: 1.1,
          duration: 0.3,
          ease: "back.out(1.7)",
        });
      });

      ctaEmail.addEventListener("mouseleave", () => {
        gsap.to(ctaEmail, {
          scale: 1,
          duration: 0.3,
          ease: "power2.out",
        });
      });
    }

    // Stagger in social links
    gsap.from(socialLinks, {
      y: 20,
      opacity: 0,
      duration: 0.5,
      stagger: 0.1,
      ease: "power2.out",
      scrollTrigger: {
        trigger: ".social-links",
        start: "top 85%",
        once: true,
      },
    });
  });
</script>
