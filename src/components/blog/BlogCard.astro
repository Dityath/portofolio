---
import type { MediumPost } from "../../types";

interface Props extends MediumPost {}

const { title, link, pubDate, description, thumbnail, categories, readTime } =
  Astro.props;
---

<article class="blog-card">
  <a
    href={link}
    target="_blank"
    rel="noopener noreferrer"
    class="blog-card-link"
  >
    {
      thumbnail && (
        <div class="blog-card-thumbnail">
          <img src={thumbnail} alt={title} loading="lazy" />
        </div>
      )
    }

    <div class="blog-card-content">
      <div class="blog-card-meta">
        <span class="blog-date">{pubDate}</span>
        {readTime && <span class="blog-read-time">{readTime}</span>}
      </div>

      <h3 class="blog-card-title">{title}</h3>

      <p class="blog-card-description">{description}</p>

      {
        categories && categories.length > 0 && (
          <div class="blog-card-tags">
            {categories.slice(0, 3).map((tag) => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        )
      }

      <div class="blog-card-cta">READ ON MEDIUM →</div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    border: 3px solid var(--color-fg);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .blog-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-5px);
  }

  .blog-card-link {
    display: block;
    color: inherit;
  }

  .blog-card-thumbnail {
    width: 100%;
    height: 250px;
    overflow: hidden;
    border-bottom: 3px solid var(--color-fg);
  }

  .blog-card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-card-thumbnail img {
    transform: scale(1.05);
  }

  .blog-card-content {
    padding: 2rem;
  }

  .blog-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .blog-card-title {
    font-size: 1.5rem;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .blog-card-description {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    opacity: 0.9;
  }

  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .blog-tag {
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--color-fg);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .blog-card-cta {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    position: relative;
    display: inline-block;
  }

  .blog-card-cta::after {
    content: "";
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width 0.3s ease;
  }

  .blog-card:hover .blog-card-cta::after {
    width: 100%;
  }
</style>
