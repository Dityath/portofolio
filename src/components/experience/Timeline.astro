---
import type { Experience } from "../../types";

const experiences: Experience[] = [
  {
    company: "TECH STARTUP INC.",
    role: "Senior Fullstack Developer",
    startDate: "2022-01",
    endDate: "Present",
    achievements: [
      "Built microservices architecture serving 1M+ users",
      "Reduced API response time by 60% through optimization",
      "Led team of 5 developers in agile environment",
      "Implemented CI/CD pipeline reducing deployment time by 80%",
    ],
    techStack: [
      "React",
      "TypeScript",
      "Golang",
      "PostgreSQL",
      "Docker",
      "Kubernetes",
    ],
  },
  {
    company: "DIGITAL AGENCY CO.",
    role: "Fullstack Developer",
    startDate: "2020-06",
    endDate: "2021-12",
    achievements: [
      "Developed 15+ client websites and web applications",
      "Implemented real-time features using WebSockets",
      "Improved site performance scores to 95+ on Lighthouse",
      "Mentored junior developers and conducted code reviews",
    ],
    techStack: ["React", "Next.js", "Node.js", "MongoDB", "Tailwind CSS"],
  },
  {
    company: "E-COMMERCE PLATFORM",
    role: "Frontend Developer",
    startDate: "2019-01",
    endDate: "2020-05",
    achievements: [
      "Built responsive e-commerce platform from scratch",
      "Integrated payment gateways and shipping APIs",
      "Implemented advanced product filtering and search",
      "Achieved 99.9% uptime during Black Friday sales",
    ],
    techStack: ["React", "Redux", "TypeScript", "SASS", "Jest"],
  },
];
---

<section class="timeline-section">
  <div class="container-brutal">
    <h1 class="page-title">WORK EXPERIENCE</h1>

    <div class="timeline">
      <div class="timeline-line" id="timeline-line"></div>

      {
        experiences.map((exp) => (
          <article class="timeline-item">
            <div class="timeline-dot" />

            <div class="timeline-content">
              <div class="timeline-header">
                <h2 class="company-name">{exp.company}</h2>
                <span class="timeline-date">
                  {exp.startDate} → {exp.endDate}
                </span>
              </div>

              <h3 class="role-title">{exp.role}</h3>

              <ul class="achievements-list">
                {exp.achievements.map((achievement) => (
                  <li class="achievement-item">
                    <span class="achievement-bullet">▸</span>
                    {achievement}
                  </li>
                ))}
              </ul>

              <div class="tech-stack">
                {exp.techStack.map((tech) => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .timeline-section {
    min-height: 100vh;
    padding: 120px 0 80px;
  }

  .page-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 4rem;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .timeline {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding-left: 60px;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 30px;
    }
  }

  .timeline-line {
    position: absolute;
    left: 20px;
    top: 0;
    width: 4px;
    height: 100%;
    background: var(--color-fg);
    transform-origin: top;
  }

  @media (max-width: 768px) {
    .timeline-line {
      left: 10px;
    }
  }

  .timeline-item {
    position: relative;
    margin-bottom: 4rem;
    padding-left: 40px;
  }

  @media (max-width: 768px) {
    .timeline-item {
      padding-left: 20px;
    }
  }

  .timeline-dot {
    position: absolute;
    left: -40px;
    top: 10px;
    width: 20px;
    height: 20px;
    background: var(--color-accent);
    border: 4px solid var(--color-bg);
    outline: 2px solid var(--color-fg);
  }

  @media (max-width: 768px) {
    .timeline-dot {
      left: -20px;
      width: 16px;
      height: 16px;
    }
  }

  .timeline-content {
    border: 5px solid var(--color-fg);
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .timeline-content:hover {
    transform: translateX(10px);
    border-color: var(--color-accent);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .company-name {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .timeline-date {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
    opacity: 0.7;
    white-space: nowrap;
  }

  .role-title {
    font-size: 1.25rem;
    font-family: "IBM Plex Mono", monospace;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--color-accent);
  }

  .achievements-list {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .achievement-item {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.9rem;
    line-height: 1.8;
    margin-bottom: 0.5rem;
    display: flex;
    gap: 0.5rem;
  }

  .achievement-bullet {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 2px solid var(--color-fg);
  }

  .tech-badge {
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--color-fg);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    const timelineLine = document.getElementById("timeline-line");
    const timelineItems = document.querySelectorAll(".timeline-item");

    if (timelineLine) {
      // Draw timeline line on scroll
      gsap.from(timelineLine, {
        scaleY: 0,
        transformOrigin: "top",
        duration: 1,
        ease: "none",
        scrollTrigger: {
          trigger: ".timeline",
          start: "top 80%",
          end: "bottom 20%",
          scrub: 1,
        },
      });
    }

    // Animate timeline items
    timelineItems.forEach((item) => {
      // Slide in from right
      gsap.from(item, {
        x: 100,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: item,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
      });

      // Scale dot on hover
      const content = item.querySelector(".timeline-content");
      const dot = item.querySelector(".timeline-dot");

      if (content && dot) {
        content.addEventListener("mouseenter", () => {
          gsap.to(dot, {
            scale: 1.5,
            duration: 0.3,
            ease: "back.out(1.7)",
          });
        });

        content.addEventListener("mouseleave", () => {
          gsap.to(dot, {
            scale: 1,
            duration: 0.3,
            ease: "power2.out",
          });
        });
      }
    });
  });
</script>
