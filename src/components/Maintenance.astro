---
// TUI-styled maintenance page
---

<div class="maintenance-container">
  <div class="maintenance-content">
    <!-- TUI System Header -->
    <div class="tui-system-header">
      <pre
        class="ascii-art">
╔════════════════════════════════════════════════════════════════════╗
║                    SYSTEM STATUS MONITOR                           ║
╚════════════════════════════════════════════════════════════════════╝
      </pre>
    </div>

    <!-- Main Status Box -->
    <div class="status-box">
      <pre
        class="status-frame">
┌─────────────────────────────────────────────────────────────────┐
│ ⚠ SYSTEM MAINTENANCE IN PROGRESS                               │
├─────────────────────────────────────────────────────────────────┤
│                                                                 │
│  STATUS:   [●] OFFLINE                                         │
│  REASON:   Scheduled maintenance and upgrades                  │
│  ETA:      Will be back shortly                                │
│                                                                 │
├─────────────────────────────────────────────────────────────────┤
│ PROCESS LOG:                                                    │
│  ▸ Backing up databases...           [████████████] 100%       │
│  ▸ Applying system updates...        [██████░░░░░░]  50%       │
│  ▸ Optimizing performance...         [███░░░░░░░░░]  25%       │
│  ▸ Running security checks...        [░░░░░░░░░░░░]   0%       │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘
      </pre>
    </div>

    <!-- Terminal Window -->
    <div class="terminal-window">
      <div class="terminal-header">
        ┌─ root@portfolio:~/maintenance ────────────────────────────── [×] ─┐
      </div>
      <div class="terminal-body">
        <div class="terminal-line">
          <span class="prompt">root@portfolio:~/maintenance$</span>
          <span class="command">systemctl status portfolio.service</span>
        </div>
        <div class="terminal-output">
          <span class="output-bullet">●</span> portfolio.service - Portfolio Web Application
          <br />&nbsp;&nbsp;&nbsp;Loaded: loaded
          (/etc/systemd/system/portfolio.service)
          <br />&nbsp;&nbsp;&nbsp;Active: <span class="status-inactive"
            >inactive (maintenance)</span
          > since {new Date().toUTCString()}
          <br />&nbsp;&nbsp;&nbsp;Process: Performing scheduled maintenance
        </div>
        <div class="terminal-line">
          <span class="prompt">root@portfolio:~/maintenance$</span>
          <span class="command blink">_</span>
        </div>
      </div>
      <div class="terminal-footer">
        └───────────────────────────────────────────────────────────────────┘
      </div>
    </div>

    <!-- Info Boxes Grid -->
    <div class="info-boxes">
      <div class="info-box">
        <pre
          class="info-content">
┌─ CONTACT ────────┐
│ 📧 Email Support │
│ 🐙 GitHub Issues │
│ 💬 Discord       │
└──────────────────┘
        </pre>
      </div>

      <div class="info-box">
        <pre
          class="info-content">
┌─ UPDATES ────────┐
│ ⏱ Last: {new Date().toLocaleTimeString()} │
│ 🔄 Refreshing... │
│ ⚡ Auto-reload   │
└──────────────────┘
        </pre>
      </div>

      <div class="info-box">
        <pre
          class="info-content">
┌─ SERVICES ───────┐
│ ❌ WEB           │
│ ❌ API           │
│ ✅ STATUS PAGE   │
└──────────────────┘
        </pre>
      </div>
    </div>

    <!-- System Stats -->
    <div class="system-stats">
      <pre
        class="stats-content">
╔══════════════════════════════════════════════════════════════════╗
║ MAINTENANCE STATISTICS                                           ║
╠══════════════════════════════════════════════════════════════════╣
║  Uptime This Month:     99.97%        Mean Time To Repair: 45min ║
║  Scheduled Maintenance: Q1 2026       Last Incident:      None   ║
╚══════════════════════════════════════════════════════════════════╝
      </pre>
    </div>

    <!-- Animated Loading -->
    <div class="loading-animation">
      <div class="loading-text">PLEASE WAIT</div>
      <div class="loading-bar">
        <div class="loading-progress"></div>
      </div>
      <div class="loading-dots">
        <span class="dot">█</span>
        <span class="dot">█</span>
        <span class="dot">█</span>
        <span class="dot">█</span>
        <span class="dot">█</span>
      </div>
    </div>
  </div>
</div>

<style>
  .maintenance-container {
    min-height: 100vh;
    width: 100%;
    background: var(--color-bg);
    color: var(--color-fg);
    padding: 2rem;
    overflow-x: hidden;
    position: relative;
  }

  /* Grid background */
  .maintenance-container::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      linear-gradient(var(--color-accent) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-accent) 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.05;
    z-index: 0;
    pointer-events: none;
  }

  .maintenance-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    font-family: "Fira Code", "JetBrains Mono", monospace;
  }

  /* System Header */
  .tui-system-header {
    margin-bottom: 2rem;
  }

  .ascii-art {
    font-size: clamp(0.5rem, 1.5vw, 0.8rem);
    text-align: center;
    margin: 0;
    opacity: 0.8;
    animation: pulse 2s ease-in-out infinite;
  }

  /* Status Box */
  .status-box {
    margin-bottom: 2rem;
    animation: slideDown 0.8s ease-out;
  }

  .status-frame {
    font-size: clamp(0.6rem, 1.5vw, 0.9rem);
    margin: 0;
    line-height: 1.8;
    white-space: pre;
    overflow-x: auto;
  }

  /* Terminal Window */
  .terminal-window {
    margin-bottom: 2rem;
    border: 3px solid var(--color-accent);
    animation: slideUp 0.8s ease-out;
  }

  .terminal-header,
  .terminal-footer {
    font-size: 0.75rem;
    opacity: 0.7;
    padding: 0.5rem 1rem;
    background: rgba(0, 255, 0, 0.05);
  }

  .terminal-body {
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.3);
    min-height: 200px;
  }

  .terminal-line {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .prompt {
    color: var(--color-accent);
    font-weight: 700;
  }

  .command {
    margin-left: 0.5rem;
    opacity: 0.9;
  }

  .terminal-output {
    margin: 1rem 0 1rem 1rem;
    opacity: 0.8;
    line-height: 1.8;
  }

  .output-bullet {
    color: var(--color-accent);
    font-weight: 900;
  }

  .status-inactive {
    color: #ff6b6b;
    font-weight: 700;
  }

  .blink {
    animation: blink 1s step-start infinite;
  }

  /* Info Boxes Grid */
  .info-boxes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .info-box {
    animation: fadeIn 1s ease-out;
    animation-fill-mode: both;
  }

  .info-box:nth-child(1) {
    animation-delay: 0.2s;
  }

  .info-box:nth-child(2) {
    animation-delay: 0.4s;
  }

  .info-box:nth-child(3) {
    animation-delay: 0.6s;
  }

  .info-content {
    font-size: 0.75rem;
    margin: 0;
    border: 2px solid var(--color-fg);
    padding: 0.5rem;
    line-height: 1.6;
    transition: all 0.3s ease;
  }

  .info-box:hover .info-content {
    border-color: var(--color-accent);
    background: rgba(0, 255, 0, 0.05);
    transform: translateY(-5px);
  }

  /* System Stats */
  .system-stats {
    margin-bottom: 2rem;
    animation: fadeIn 1s ease-out 0.8s both;
  }

  .stats-content {
    font-size: clamp(0.5rem, 1.2vw, 0.7rem);
    margin: 0;
    text-align: center;
    opacity: 0.7;
  }

  /* Loading Animation */
  .loading-animation {
    text-align: center;
    padding: 2rem 0;
    animation: fadeIn 1s ease-out 1s both;
  }

  .loading-text {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.5rem;
    margin-bottom: 1rem;
    color: var(--color-accent);
  }

  .loading-bar {
    width: 100%;
    max-width: 500px;
    height: 30px;
    border: 3px solid var(--color-fg);
    margin: 0 auto 1rem;
    position: relative;
    overflow: hidden;
  }

  .loading-progress {
    height: 100%;
    background: var(--color-accent);
    animation: progressBar 3s ease-in-out infinite;
  }

  .loading-dots {
    display: flex;
    justify-content: center;
    gap: 1rem;
    font-size: 1.5rem;
  }

  .dot {
    animation: dotBounce 1.4s ease-in-out infinite;
  }

  .dot:nth-child(1) {
    animation-delay: 0s;
  }
  .dot:nth-child(2) {
    animation-delay: 0.2s;
  }
  .dot:nth-child(3) {
    animation-delay: 0.4s;
  }
  .dot:nth-child(4) {
    animation-delay: 0.6s;
  }
  .dot:nth-child(5) {
    animation-delay: 0.8s;
  }

  /* Animations */
  @keyframes pulse {
    0%,
    100% {
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes progressBar {
    0% {
      width: 0%;
    }
    50% {
      width: 80%;
    }
    100% {
      width: 100%;
    }
  }

  @keyframes dotBounce {
    0%,
    80%,
    100% {
      transform: scale(1);
      opacity: 0.5;
    }
    40% {
      transform: scale(1.3);
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .maintenance-container {
      padding: 1rem;
    }

    .ascii-art,
    .status-frame {
      font-size: 0.5rem;
    }

    .terminal-line,
    .terminal-output {
      font-size: 0.75rem;
    }

    .loading-text {
      font-size: 1.5rem;
      letter-spacing: 0.3rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .ascii-art,
    .dot,
    .loading-progress,
    .blink,
    .status-box,
    .terminal-window,
    .info-box,
    .system-stats,
    .loading-animation {
      animation: none;
    }
  }
</style>

<script>
  // Auto-refresh every 60 seconds to check if maintenance mode is disabled
  setInterval(() => {
    window.location.reload();
  }, 60000);
</script>
